{
  "name": "services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @app/shared && npm run build -w @app/api && npm run build -w @app/worker && npm run build -w @app/notifier",
    "generate": "npm run generate -w @app/api && npm run generate -w @app/worker && npm run generate -w @app/notifier",
    "start:api": "node apps/api/dist/main.js",
    "start:worker": "node apps/worker/dist/worker.js",
    "start:notifier": "node apps/notifier/dist/notifier.js",
    "lint": "oxlint apps packages",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "oxlint": "^1.58.0",
    "pg": "^8.16.3",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
