# Local development credentials ONLY. Never reuse these outside this project.
POSTGRES_USER=converter
POSTGRES_PASSWORD=converter
POSTGRES_DB=converter

# one database per service (database-per-service ownership)
MINIO_API_PASSWORD=api-secret
MINIO_WORKER_PASSWORD=worker-secret
MINIO_NOTIFIER_PASSWORD=notifier-secret

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

MINIO_ENDPOINT=localhost   # host-side runs; containers use `minio`
MINIO_PORT=9000
MINIO_PRESIGN_HOST=localhost
MINIO_ACCESS_KEY=api       # host-side local runs speak to MinIO as the api user
MINIO_SECRET_KEY=api-secret

RABBITMQ_URL=amqp://guest:guest@localhost:5672
DATABASE_URL=postgresql://converter:converter@localhost:5434/converter_api
WORKER_DATABASE_URL=postgresql://converter:converter@localhost:5434/converter_worker
NOTIFIER_DATABASE_URL=postgresql://converter:converter@localhost:5434/converter_notifier

API_PORT=3000
MAX_UPLOAD_MB=200
MAX_ATTEMPTS=3
PRESIGN_EXPIRY_SECONDS=1800

SMTP_HOST=localhost
SMTP_PORT=1025

VITE_API_URL=http://localhost:3000
FRONTEND_PORT=5173
